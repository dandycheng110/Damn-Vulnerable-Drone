<?xml version="1.0" ?>
<!--
  Damn Vulnerable Drone world, Gazebo Harmonic port of
  simulator/assets/worlds/damn-vulnerable-drone.world.

  Changes from the Classic world:
  - SDF 1.6 -> 1.9; gz-sim systems are listed explicitly (physics, sensors
    with ogre2, IMU for the ArduPilot plugin, scene broadcaster for the web
    viewer, user commands for world reset).
  - ODE quick-solver settings -> default DART at 1 ms (as the official
    ardupilot_gazebo worlds use; ArduPilot lock-step expects 1 kHz).
  - Gazebo/Runway + Gazebo/Grass OGRE scripts -> official ardupilot_gazebo
    runway model (PBR textures) rotated to lie along +x like the old runway.
  - The stray <projection_type> inside the operator include is dropped.
  - Frame convention: the official ArduPilotPlugin uses gazeboXYZToNED
    180 0 90, i.e. world +x = East, +y = North (ENU). The scene layout keeps
    the Classic coordinates, so objects sit in the same place in Gazebo but
    the compass heading of the scene differs from Classic.
-->
<sdf version="1.9">
  <world name="default">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <sky></sky>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5 0 1 0 0.2 0</pose>
      </camera>
    </gui>

    <!-- Same values as Classic model://sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="grass">
          <pose>0 0 -0.1 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.15 1</ambient>
            <diffuse>0.25 0.45 0.15 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      The runway model carries its own collision plane at z=0; the ground
      plane above already covers that, so this is visual only in practice.
    -->
    <include>
      <uri>model://runway</uri>
      <pose degrees="true">0 0 0.005 0 0 -90</pose>
    </include>

    <include>
      <uri>model://hacker_van</uri>
      <pose>4.34581 -6.72978 0.05 0 0 0.7586</pose>
    </include>

    <include>
      <uri>model://hacker_desk</uri>
      <pose>3.73953 -3.3219 0.001958 0 0 -0.756161</pose>
    </include>

    <include>
      <uri>model://gcs_table</uri>
      <pose>-4 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://operator</uri>
      <pose>-4.74585 -0.010506 -0.145856 0 0 1.65382</pose>
    </include>

    <include>
      <uri>model://gcs_chair</uri>
      <pose>-4.41943 -0.415139 0 0 0 1.68293</pose>
    </include>

    <include>
      <uri>model://laptop</uri>
      <pose>-4.04083 -0.118429 0.809145 0 0 -1.90525</pose>
    </include>

    <!--
      Classic wrapped iris_with_ardupilot in a model named iris_demo at
      z=0.02 (the old airframe carried a +0.195 model pose). The official
      airframe has its origin at the body centre, so spawn at 0.02 + 0.195.
    -->
    <include>
      <uri>model://dvd_iris</uri>
      <name>iris_demo</name>
      <pose>0 0 0.215 0 0 0</pose>
    </include>

    <model name="launch_pad">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="base">
        <visual name="visual">
          <geometry>
            <box>
              <size>2 2 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 0.5</ambient>
            <diffuse>0.5 0.5 0.5 0.5</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
